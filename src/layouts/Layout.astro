---
import "../styles/global.css";
import NavigationIsland from "../components/islands/NavigationIsland";
import { Footer } from "../components/islands/Footer";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>Pondok Pesantren Darurrohman | Ponpes Darurrohman Tegalrejo</title>

    <meta
      name="google-site-verification"
      content="o8Y5I15TNxSb5T5av4a7QNeTMIbu_L_4mhsJl_H8sNM"
    />
    <meta
      name="description"
      content="Pondok Pesantren Darurrohman Tegalrejo adalah ponpes tahfidz Al-Qur’an dengan pendidikan akademik dan pembinaan karakter santri."
    />
    <meta
      name="keywords"
      content="ponpes darurrohman, pondok pesantren darurrohman, pesantren tegalrejo, ponpes tahfidz"
    />
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
