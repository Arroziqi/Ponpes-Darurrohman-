---
import { Phone, MessageCircle, Mail, MapPin, Clock, Send } from "lucide-react";

const contactInfo = [
  {
    icon: Phone,
    title: "Telepon",
    detail: "+62 812-3456-7890",
    link: "tel:+628123456789",
  },
  {
    icon: MessageCircle,
    title: "WhatsApp",
    detail: "+62 812-3456-7890",
    link: "https://wa.me/628123456789",
  },
  {
    icon: Mail,
    title: "Email",
    detail: "info@darurrohman.id",
    link: "mailto:info@darurrohman.id",
  },
  {
    icon: MapPin,
    title: "Alamat",
    detail: "Jl. Pendidikan No. 123, Kota, Provinsi 12345",
    link: "https://maps.google.com",
  },
];

const officeHours = [
  { day: "Senin - Jumat", hours: "08:00 - 16:00 WIB" },
  { day: "Sabtu", hours: "08:00 - 12:00 WIB" },
  { day: "Minggu", hours: "Tutup" },
];
---

<div class="min-h-screen">
  {/* Hero Section */}
  <section
    class="relative bg-linear-to-br from-emerald-800 to-emerald-900 text-white py-20"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span
          class="inline-block bg-emerald-600/50 text-white px-4 py-2 rounded-full text-sm backdrop-blur-sm mb-6"
        >
          Kontak Kami
        </span>
        <h1 class="text-4xl md:text-5xl mb-6 leading-tight">Hubungi Kami</h1>
        <p class="text-xl text-emerald-50 leading-relaxed">
          Punya pertanyaan tentang program tahfidz atau pendaftaran? Jangan ragu
          untuk menghubungi kami. Tim kami siap membantu Anda.
        </p>
      </div>
    </div>
  </section>

  {/* Contact Info Cards */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        {
          contactInfo.map((info, index) => {
            const Icon = info.icon;

            return (
              <a
                href={info.link}
                target={info.link.startsWith("http") ? "_blank" : undefined}
                rel={
                  info.link.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                class="bg-linear-to-br from-emerald-50 to-white border-2 border-emerald-100 rounded-xl p-6 hover:shadow-lg transition-all duration-300 hover:scale-105"
              >
                <div class="bg-white w-12 h-12 rounded-lg flex items-center justify-center mb-4 shadow-sm">
                  <Icon className="w-6 h-6 text-emerald-700" />
                </div>

                <h3 class="text-lg mb-2 text-gray-900">{info.title}</h3>
                <p class="text-gray-600">{info.detail}</p>
              </a>
            );
          })
        }
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        {/* Contact Form */}
        <div class="bg-white">
          <h2 class="text-3xl mb-6 text-gray-900">Kirim Pesan</h2>
          <form id="contact-form" class="space-y-6">
            <div>
              <label for="name" class="block text-gray-700 mb-2">
                Nama Lengkap
              </label>
              <input
                type="text"
                id="name"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                placeholder="Masukkan nama lengkap"
              />
            </div>

            <div>
              <label for="email" class="block text-gray-700 mb-2">
                Email
              </label>
              <input
                type="email"
                id="email"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                placeholder="nama@email.com"
              />
            </div>

            <div>
              <label for="phone" class="block text-gray-700 mb-2">
                Nomor Telepon
              </label>
              <input
                type="tel"
                id="phone"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
                placeholder="+62 812-3456-7890"
              />
            </div>

            <div>
              <label for="subject" class="block text-gray-700 mb-2">
                Subjek
              </label>
              <select
                id="subject"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
              >
                <option value="">Pilih subjek</option>
                <option value="pendaftaran">Pendaftaran Santri Baru</option>
                <option value="program">Informasi Program</option>
                <option value="kunjungan">Kunjungan Pondok</option>
                <option value="lainnya">Lainnya</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-gray-700 mb-2">
                Pesan
              </label>
              <textarea
                id="message"
                rows={5}
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent resize-none"
                placeholder="Tulis pesan Anda di sini..."></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-emerald-700 text-white px-8 py-4 rounded-lg hover:bg-emerald-800 transition-colors flex items-center justify-center gap-2 group"
            >
              <Send
                className="w-5 h-5 group-hover:translate-x-1 transition-transform"
              />
              Kirim Pesan
            </button>
          </form>
        </div>

        {/* Office Hours & Info */}
        <div class="space-y-8">
          <div
            class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-8"
          >
            <div class="flex items-center gap-3 mb-6">
              <div
                class="bg-emerald-700 w-12 h-12 rounded-lg flex items-center justify-center"
              >
                <Clock className="w-6 h-6 text-white" />
              </div>
              <h3 class="text-2xl text-gray-900">Jam Operasional</h3>
            </div>
            <div class="space-y-4">
              {
                officeHours.map((schedule, index) => (
                  <div class="flex justify-between items-center py-3 border-b border-emerald-100 last:border-0">
                    <span class="text-gray-700">{schedule.day}</span>
                    <span class="text-emerald-700 font-semibold">
                      {schedule.hours}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="bg-emerald-700 text-white rounded-xl p-8">
            <h3 class="text-2xl mb-4">Kunjungi Pondok</h3>
            <p class="text-emerald-50 mb-6 leading-relaxed">
              Kami menerima kunjungan dari calon santri dan orang tua untuk
              melihat langsung fasilitas dan bertemu dengan pengurus pondok.
            </p>
            <a
              href="https://wa.me/628123456789?text=Assalamualaikum,%20saya%20ingin%20menjadwalkan%20kunjungan%20ke%20Pondok%20Pesantren%20Darurrohman"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-white text-emerald-700 px-6 py-3 rounded-lg hover:bg-emerald-50 transition-colors w-full"
            >
              <MessageCircle className="w-5 h-5 mr-2" />
              Jadwalkan Kunjungan
            </a>
          </div>

          <div
            class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-8"
          >
            <h3 class="text-2xl mb-4 text-gray-900">Informasi Cepat</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-2">
                <span
                  class="inline-block w-2 h-2 bg-emerald-600 rounded-full mt-2 shrink-0"
                ></span>
                <span>Balasan email dalam 1x24 jam</span>
              </li>
              <li class="flex items-start gap-2">
                <span
                  class="inline-block w-2 h-2 bg-emerald-600 rounded-full mt-2 shrink-0"
                ></span>
                <span>WhatsApp aktif 24/7</span>
              </li>
              <li class="flex items-start gap-2">
                <span
                  class="inline-block w-2 h-2 bg-emerald-600 rounded-full mt-2 shrink-0"
                ></span>
                <span>Konsultasi gratis untuk calon santri</span>
              </li>
              <li class="flex items-start gap-2">
                <span
                  class="inline-block w-2 h-2 bg-emerald-600 rounded-full mt-2 shrink-0"
                ></span>
                <span>Tersedia panduan lengkap pendaftaran</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Map Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block text-emerald-600 font-semibold mb-4"
          >Lokasi Kami</span
        >
        <h2 class="text-3xl md:text-4xl text-gray-900 mb-4">Temukan Kami</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Pondok Pesantren Darurrohman berlokasi di area yang strategis dan
          mudah diakses dengan lingkungan yang kondusif untuk belajar.
        </p>
      </div>

      <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
        {/* Map Placeholder */}
        <div class="relative h-96 bg-gray-200">
          <iframe
            src="https://www.google.com/maps?q=Pondok%20Pesantren%20Darurrohman%20Dlimas%20Tegalrejo&output=embed"
            width="100%"
            height="100%"
            style={{ border: 0 }}
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokasi Pondok Pesantren Darurrohman"></iframe>
        </div>

        <div class="p-8 bg-linear-to-br from-emerald-50 to-white">
          <div class="grid md:grid-cols-3 gap-8">
            <div>
              <h3 class="text-lg mb-2 text-gray-900">Alamat Lengkap</h3>
              <p class="text-gray-600">
                Jl. Pendidikan No. 123<br />
                Kelurahan, Kecamatan<br />
                Kota, Provinsi 12345
              </p>
            </div>
            <div>
              <h3 class="text-lg mb-2 text-gray-900">Akses Transportasi</h3>
              <p class="text-gray-600">
                • 5 menit dari Terminal Kota<br />
                • 10 menit dari Stasiun<br />
                • 20 menit dari Bandara
              </p>
            </div>
            <div>
              <h3 class="text-lg mb-2 text-gray-900">Landmark</h3>
              <p class="text-gray-600">
                Dekat dengan Masjid Agung<br />
                Sebelah Taman Kota<br />
                Belakang Mall Besar
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ Quick Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block text-emerald-600 font-semibold mb-4">FAQ</span
        >
        <h2 class="text-3xl md:text-4xl text-gray-900 mb-4">Pertanyaan Umum</h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-6">
        <div
          class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-6"
        >
          <h3 class="text-xl mb-3 text-gray-900">
            Berapa lama proses pendaftaran?
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Proses pendaftaran memakan waktu sekitar 2-3 minggu dari pendaftaran
            hingga pengumuman hasil seleksi.
          </p>
        </div>

        <div
          class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-6"
        >
          <h3 class="text-xl mb-3 text-gray-900">
            Apakah tersedia program beasiswa?
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Ya, kami menyediakan program beasiswa untuk santri berprestasi dan
            yang membutuhkan bantuan finansial. Silakan hubungi kami untuk
            informasi lebih lanjut.
          </p>
        </div>

        <div
          class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-6"
        >
          <h3 class="text-xl mb-3 text-gray-900">
            Bisakah orang tua mengunjungi santri?
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Tentu, orang tua dapat mengunjungi santri pada hari dan jam yang
            telah ditentukan. Kunjungan dapat dijadwalkan sebelumnya melalui
            kantor pondok.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    alert(
      "Terima kasih! Pesan Anda telah dikirim. Tim kami akan segera menghubungi Anda.",
    );

    form.reset();
  });
</script>
