---
import { Phone, MessageCircle, Mail, MapPin, Clock, Send } from "lucide-react";

const contactInfo = [
  {
    icon: MessageCircle,
    title: "WhatsApp",
    detail: "+62 857-4052-2137 (ust khalid)",
    link: "https://wa.me/6285740522137",
  },
  {
    icon: MapPin,
    title: "Alamat",
    detail: "Butuh, Dlimas, Kec. Tegalrejo, Kabupaten Magelang, Jawa Tengah 56192",
    link: "https://share.google/KqV8PZGgbnAOLNeKw",
  },
];

const registrationHours = [
  {
    session: "Siang",
    hours: "12.30 – 14.00 WIB",
  },
  {
    session: "Malam",
    hours: "Ba’da Maghrib – 21.00 WIB",
  },
];
---

<div class="min-h-screen">
  {/* Hero Section */}
  <section
    class="relative bg-linear-to-br from-emerald-800 to-emerald-900 text-white py-20"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span
          class="inline-block bg-emerald-600/50 text-white px-4 py-2 rounded-full text-sm backdrop-blur-sm mb-6"
        >
          Kontak Kami
        </span>
        <h1 class="text-4xl md:text-5xl mb-6 leading-tight">Hubungi Kami</h1>
        <p class="text-xl text-emerald-50 leading-relaxed">
          Punya pertanyaan tentang program tahfidz atau pendaftaran? Jangan ragu
          untuk menghubungi kami. Tim kami siap membantu Anda.
        </p>
      </div>
    </div>
  </section>

  {/* Contact Info Cards */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">

        {/* LEFT COLUMN */}
        <div class="space-y-8">

          <!-- Contact Info Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {
              contactInfo.map((info, index) => {
                const Icon = info.icon;

                return (
                    <a
                        href={info.link}
                        target={info.link.startsWith("http") ? "_blank" : undefined}
                        rel={
                          info.link.startsWith("http")
                              ? "noopener noreferrer"
                              : undefined
                        }
                        class="bg-linear-to-br from-emerald-50 to-white border-2 border-emerald-100 rounded-xl p-6 hover:shadow-lg transition-all duration-300 hover:scale-105"
                    >
                      <div class="bg-white w-12 h-12 rounded-lg flex items-center justify-center mb-4 shadow-sm">
                        <Icon className="w-6 h-6 text-emerald-700" />
                      </div>

                      <h3 class="text-lg mb-2 text-gray-900">{info.title}</h3>
                      <p class="text-gray-600">{info.detail}</p>
                    </a>
                );
              })
            }
          </div>

          <!-- Waktu Pendaftaran -->
          <div class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="bg-emerald-700 w-12 h-12 rounded-lg flex items-center justify-center">
                <Clock className="w-6 h-6 text-white" />
              </div>
              <h3 class="text-2xl text-gray-900">Waktu Pendaftaran</h3>
            </div>

            <div class="space-y-4">
              {registrationHours.map((item, index) => (
                  <div
                      class="flex justify-between items-center py-3 border-b border-emerald-100 last:border-0"
                  >
                    <span class="text-gray-700">{item.session}</span>
                    <span class="text-emerald-700 font-semibold">
              {item.hours}
            </span>
                  </div>
              ))}

              <div class="pt-3 text-sm text-gray-500">
                *Tidak melayani pendaftaran pada hari Kamis dan Jumat
              </div>
            </div>
          </div>

        </div>

        {/* RIGHT COLUMN */}
        <div class="space-y-8">

          <!-- Kunjungi Pondok -->
          <div class="bg-emerald-700 text-white rounded-xl p-8">
            <h3 class="text-2xl mb-4">Kunjungi Pondok</h3>
            <p class="text-emerald-50 mb-6 leading-relaxed">
              Kami menerima kunjungan dari calon santri dan orang tua untuk
              melihat langsung fasilitas dan bertemu dengan pengurus pondok.
            </p>
            <a
                href="https://wa.me/6285740522137?text=Assalamualaikum,%20saya%20ingin%20menjadwalkan%20kunjungan%20ke%20Pondok%20Pesantren%20Darurrohman"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center bg-white text-emerald-700 px-6 py-3 rounded-lg hover:bg-emerald-50 transition-colors w-full"
            >
              <MessageCircle className="w-5 h-5 mr-2" />
              Jadwalkan Kunjungan
            </a>
          </div>

          <!-- Informasi Cepat -->
          <div class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-8">
            <h3 class="text-2xl mb-4 text-gray-900">Informasi Cepat</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-2">
                <span class="inline-block w-2 h-2 bg-emerald-600 rounded-full mt-2 shrink-0"></span>
                <span>WhatsApp aktif 24/7</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="inline-block w-2 h-2 bg-emerald-600 rounded-full mt-2 shrink-0"></span>
                <span>Konsultasi gratis untuk calon santri</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="inline-block w-2 h-2 bg-emerald-600 rounded-full mt-2 shrink-0"></span>
                <span>Tersedia panduan lengkap pendaftaran</span>
              </li>
            </ul>
          </div>

        </div>
      </div>
    </div>
  </section>

  {/* Map Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block text-emerald-600 font-semibold mb-4"
          >Lokasi Kami</span
        >
        <h2 class="text-3xl md:text-4xl text-gray-900 mb-4">Temukan Kami</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Pondok Pesantren Darurrohman berlokasi di area yang strategis dan
          mudah diakses dengan lingkungan yang kondusif untuk belajar.
        </p>
      </div>

      <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
        {/* Map Placeholder */}
        <div class="relative h-96 bg-gray-200">
          <iframe
            src="https://www.google.com/maps?q=Pondok%20Pesantren%20Darurrohman%20Dlimas%20Tegalrejo&output=embed"
            width="100%"
            height="100%"
            style={{ border: 0 }}
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokasi Pondok Pesantren Darurrohman"></iframe>
        </div>

        <div class="p-8 bg-linear-to-br from-emerald-50 to-white">
          <div class="grid md:grid-cols-3 gap-8">
            <div>
              <h3 class="text-lg mb-2 text-gray-900">Alamat Lengkap</h3>
              <p class="text-gray-600">
                Dusun Butuh<br />
                Desa Dlimas, Kecamatan Tegalrejo<br />
                Kabupaten Magelang, Provinsi Jawa Tengah
              </p>
            </div>
            <div>
              <h3 class="text-lg mb-2 text-gray-900">Akses Transportasi</h3>
              <p class="text-gray-600">
                • 5 menit dari Terminal Tegalrejo<br />
              </p>
            </div>
            <div>
              <h3 class="text-lg mb-2 text-gray-900">Landmark</h3>
              <p class="text-gray-600">
                Arah lapangan desa Dlimas
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ Quick Section */}
  <section hidden class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block text-emerald-600 font-semibold mb-4">FAQ</span
        >
        <h2 class="text-3xl md:text-4xl text-gray-900 mb-4">Pertanyaan Umum</h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-6">
        <div
          class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-6"
        >
          <h3 class="text-xl mb-3 text-gray-900">
            Berapa lama proses pendaftaran?
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Proses pendaftaran memakan waktu sekitar 2-3 minggu dari pendaftaran
            hingga pengumuman hasil seleksi.
          </p>
        </div>

        <div
          class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-6"
        >
          <h3 class="text-xl mb-3 text-gray-900">
            Apakah tersedia program beasiswa?
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Ya, kami menyediakan program beasiswa untuk santri berprestasi dan
            yang membutuhkan bantuan finansial. Silakan hubungi kami untuk
            informasi lebih lanjut.
          </p>
        </div>

        <div
          class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-xl p-6"
        >
          <h3 class="text-xl mb-3 text-gray-900">
            Bisakah orang tua mengunjungi santri?
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Tentu, orang tua dapat mengunjungi santri pada hari dan jam yang
            telah ditentukan. Kunjungan dapat dijadwalkan sebelumnya melalui
            kantor pondok.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    alert(
      "Terima kasih! Pesan Anda telah dikirim. Tim kami akan segera menghubungi Anda.",
    );

    form.reset();
  });
</script>
