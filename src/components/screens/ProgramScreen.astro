---
import {
  BookOpen,
  Target,
  Clock,
  Users,
  Award,
  CheckCircle2,
} from "lucide-react";
import { ImageWithFallback } from "../islands/figma/ImageWithFallback";

const programs = [
  {
    title: "Takhassus Al-Qur’an",
    duration: "Target 1 Tahun (Bil Ghoib / Bil Hifdzi)",
    target: "Khatam 30 Juz",
    description:
        "Program Takhassus Al-Qur’an dengan fokus bin nadzor/tahsin serta bil ghoib / bil hifdzi dengan target khatam 30 juz dalam 1 tahun melalui bimbingan intensif dan metode terstruktur.",
    features: [
      "Bin nadzor / tahsin",
      "Bil ghoib / Bil hifdzi (target 1 tahun khatam)",
      "Setoran hafalan harian",
      "Muraja’ah terjadwal",
      "Evaluasi hafalan berkala",
    ],
    color: "emerald",
  },
  {
    title: "Ngaji Kitab Kuning",
    duration: "Program Berjenjang",
    target: "Pendalaman Ilmu Keislaman",
    description:
        "Pembelajaran kitab kuning meliputi Ilmu Alat (Nahwu & Shorof), Fiqh Dasar, Tafsir, dan Tajwid sebagai fondasi pemahaman keislaman yang komprehensif dan terstruktur.",
    features: [
      "Ilmu Alat (Nahwu & Shorof)",
      "Fiqh Dasar",
      "Tafsir",
      "Tajwid",
      "Pembelajaran sistem halaqah",
    ],
    color: "teal",
  },
  {
    title: "Sekolah Formal",
    duration: "Sesuai Jenjang Pendidikan",
    target: "Pendidikan Akademik Terakreditasi",
    description:
        "Program pendidikan formal melalui Kejar Paket A/B/C serta kerja sama dengan MTs Yakti Tegalrejo untuk jenjang SLTP guna mendukung keseimbangan antara pendidikan diniyah dan akademik.",
    features: [
      "Program Kejar Paket A/B/C",
      "Kerja sama dengan MTs Yakti Tegalrejo (SLTP)",
      "Kurikulum terstruktur",
      "Ijazah resmi sesuai jenjang",
      "Pendampingan akademik",
    ],
    color: "cyan",
  },
];

const icons = {
  BookOpen,
  Target,
  Clock,
  Users,
} as const;

type IconName = keyof typeof icons;

type Method = {
  title: string;
  description: string;
  icon: IconName;
};

const methods: Method[] = [
  {
    icon: "BookOpen",
    title: "Metode Talqin",
    description:
      "Santri menyimak bacaan ustadz kemudian menirukan dengan benar.",
  },
  {
    icon: "Target",
    title: "Metode Wahdah",
    description:
      "Menghafal satu per satu ayat hingga lancar sebelum lanjut ayat berikutnya.",
  },
  {
    icon: "Clock",
    title: "Muraja'ah Rutin",
    description:
      "Pengulangan hafalan secara terjadwal untuk menjaga kualitas hafalan.",
  },
  {
    icon: "Users",
    title: "Tasmi' Jama'i",
    description:
      "Mendengarkan hafalan bersama untuk saling mengoreksi dan menguatkan.",
  },
];

const schedule = [
  { time: "03:00 - 07:00", activity: "Tahajjud || Mujahadah Harian || Shubuh Jama’ah || Majelis Sabaq (Ziyadah Hafalan)" },
  { time: "08:30 - 11:00", activity: "Dhuha || Majelis Sabqi (Muraja’ah Hafalan)" },
  { time: "12:30 - 14:00", activity: "Dzuhur Jama’ah || Ta’lim || Majelis Sabaq || Ngaji Alat" },
  { time: "15:30 - 17:00", activity: "Ashar Jama’ah || Yasinan || Majelis Sabaq" },
  { time: "18:00 - 21:00", activity: "Maghrib Jama’ah || Ngaji Fiqh || Isya’ Jama’ah || Musyawarah Harian || Majelis Manzil || Ngaji Alat" },
];

const facilities = [
  "Asrama nyaman dan bersih",
  "Ruang belajar ber-AC",
  "Perpustakaan lengkap",
  "Masjid representatif",
  "Kantin sehat",
  "Lapangan olahraga",
  "Klinik kesehatan",
  "Free WiFi area",
];
---

<div class="min-h-screen">
  {/* Hero Section */}
  <section
    class="relative bg-linear-to-br from-emerald-800 to-emerald-900 text-white py-20"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span
          class="inline-block bg-emerald-600/50 text-white px-4 py-2 rounded-full text-sm backdrop-blur-sm mb-6"
        >
          Program Kami
        </span>
        <h1 class="text-4xl md:text-5xl mb-6 leading-tight">
          Program Pesantren
        </h1>
        <p class="text-xl text-emerald-50 leading-relaxed">
          Program ini disusun guna menyiapkan santri yang Alim, berintegritas terhadap Al-Qur’an, serta memiliki keseimbangan antara pendidikan diniyah dan akademik.
        </p>
      </div>
    </div>
  </section>

  {/* Programs */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block text-emerald-600 font-semibold mb-4">Program Pendidikan</span>
        <h2 class="text-3xl md:text-4xl text-gray-900 mb-4">
          Program Unggulan Kami
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Kami menghadirkan program terpadu meliputi Takhassus Al-Qur’an, Ngaji Kitab Kuning,
          serta Sekolah Formal untuk membentuk generasi yang berilmu, berakhlak, dan berprestasi.
        </p>
      </div>

      <div class="space-y-8">
        {
          programs.map((program, index) => (
            <div class="bg-linear-to-br from-emerald-50 to-white border-2 border-emerald-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
              <div class="grid md:grid-cols-3 gap-8">
                <div class="md:col-span-2">
                  <div class="flex items-start gap-4 mb-4">
                    <div class="bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-semibold">
                      {program.duration}
                    </div>
                    <div class="bg-emerald-100 text-emerald-800 px-4 py-2 rounded-lg text-sm font-semibold">
                      {program.target}
                    </div>
                  </div>
                  <h3 class="text-2xl md:text-3xl mb-4 text-gray-900">
                    {program.title}
                  </h3>
                  <p class="text-gray-600 mb-6 leading-relaxed">
                    {program.description}
                  </p>
                  <div>
                    <h4 class="font-semibold text-gray-900 mb-3">
                      Keunggulan Program:
                    </h4>
                    <ul class="space-y-2">
                      {program.features.map((feature, idx) => (
                        <li class="flex items-start gap-2">
                          <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
                          <span class="text-gray-600">{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="flex items-center justify-center">
                  <div class="bg-emerald-700 text-white rounded-2xl p-8 text-center w-full max-w-xs">
                    <Award className="w-16 h-16 mx-auto mb-4" />
                    <div class="text-4xl mb-2">
                      {program.target.split(" ")[0]}
                    </div>
                    <div class="text-emerald-100">Target Hafalan</div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Methods */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block text-emerald-600 font-semibold mb-4"
          >Metode Pembelajaran</span
        >
        <h2 class="text-3xl md:text-4xl text-gray-900 mb-4">
          Metode Tahfidz yang Efektif
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Kami menggunakan metode pembelajaran yang telah terbukti efektif dalam
          membantu santri menghafal Al-Qur'an.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          methods.map((method, index) => {
            const Icon = icons[method.icon];

            return (
              <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow text-center">
                <div class="bg-emerald-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                  <Icon className="w-8 h-8 text-emerald-700" />
                </div>
                <h3 class="text-xl mb-3 text-gray-900">{method.title}</h3>
                <p class="text-gray-600 leading-relaxed">
                  {method.description}
                </p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* Schedule */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="inline-block text-emerald-600 font-semibold mb-4"
            >Jadwal Harian</span
          >
          <h2 class="text-3xl md:text-4xl mb-6 text-gray-900">
            Rutinitas Santri
          </h2>
          <p class="text-gray-600 mb-8 leading-relaxed">
            Jadwal harian yang terstruktur untuk memaksimalkan waktu belajar dan
            hafalan Al-Qur'an dengan tetap menjaga kesehatan dan istirahat yang
            cukup.
          </p>
          <div class="relative h-96 rounded-2xl overflow-hidden shadow-lg">
            <ImageWithFallback
              src="https://images.unsplash.com/photo-1625111380820-9a371d413cc4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxzdHVkZW50cyUyMHN0dWR5aW5nJTIwdG9nZXRoZXJ8ZW58MXx8fHwxNzY5OTQ0MzE4fDA&ixlib=rb-4.1.0&q=80&w=1080"
              alt="Santri belajar bersama"
              className="w-full h-full object-cover"
            />
          </div>
        </div>
        <div
          class="bg-linear-to-br from-emerald-50 to-white border border-emerald-100 rounded-2xl p-6"
        >
          <h3 class="text-xl mb-6 text-gray-900">Jadwal Kegiatan Harian</h3>
          <div class="space-y-3">
            {
              schedule.map((item, index) => (
                <div class="flex items-start gap-4 pb-3 border-b border-emerald-100 last:border-0">
                  <div class="bg-emerald-700 text-white px-3 py-1 rounded text-sm font-semibold shrink-0 mt-0.5">
                    {item.time}
                  </div>
                  <div class="text-gray-700 flex-1">{item.activity}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Facilities */}
  <section hidden
    class="py-16 md:py-24 bg-linear-to-br from-emerald-700 to-emerald-900 text-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span
          class="inline-block bg-emerald-600/50 text-white px-4 py-2 rounded-full text-sm backdrop-blur-sm mb-6"
        >
          Fasilitas
        </span>
        <h2 class="text-3xl md:text-4xl mb-4">Fasilitas Lengkap & Nyaman</h2>
        <p class="text-emerald-50 max-w-2xl mx-auto">
          Kami menyediakan fasilitas yang mendukung kenyamanan belajar dan
          kehidupan santri di pondok.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          facilities.map((facility, index) => (
            <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6 text-center hover:bg-white/20 transition-colors">
              <CheckCircle2 className="w-8 h-8 mx-auto mb-3" />
              <div class="text-white">{facility}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</div>
